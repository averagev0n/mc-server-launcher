{
  "name": "mc-server-launcher",
  "version": "1.0.7",
  "description": "Лаунчер для запуска сервера Minecraft на своём ПК",
  "author": "averagev0n",
  "repository": {
    "type": "git",
    "url": "https://github.com/averagev0n/mc-server-launcher.git"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js",
    "test": "node --test \"test/*.test.js\""
  },
  "build": {
    "appId": "local.mcserverlauncher",
    "productName": "Блокхост",
    "executableName": "MC Server Launcher",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "CHANGELOG.md",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "averagev0n",
        "repo": "mc-server-launcher",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Блокхост",
      "artifactName": "MC-Server-Launcher-Setup.${ext}"
    },
    "portable": {
      "artifactName": "MC-Server-Launcher-Portable.${ext}"
    },
    "asarUnpack": [
      "lib/mapworker.js",
      "lib/maprender.js",
      "lib/nbt.js"
    ]
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "tar": "^7.5.23",
    "yaml": "^2.9.1"
  }
}
